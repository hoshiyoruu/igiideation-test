// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid()) @map("_id")
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Judge {
  id                 String               @id @default(uuid()) @map("_id")
  name               String
  email              String               @unique
  password           String
  association        String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  JudgeProjectBridge JudgeProjectBridge[]
  projectToBeJudged  String[]
}

model Project {
  id                      String               @id @default(uuid()) @map("_id")
  titleOfInnovation       String
  abstractLink            String
  supportingDocumentLink1 String
  supportingDocumentLink2 String
  supportingDocumentLink3 String
  posterLink              String
  videoLink               String
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  status                  ProjectStatus
  JudgeProjectBridge      JudgeProjectBridge[]
  assignedJudges          String[]
}

enum ProjectStatus {
  PENDING
  COMPLETE
}

model JudgeProjectBridge {
  id                       String  @id @default(uuid()) @map("_id")
  judge                    Judge   @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  project                  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  judgeId                  String
  projectId                String
  noveltyAndUniquenessMark Int @default(0)
  benefitToMankindMark     Int @default(0)
  commercializationMark    Int @default(0)
  statusOfInventionMark    Int @default(0)
  videoPresentationMark    Int @default(0)
  supportingDocumentMark   Int @default(0)
  comments                 String?
  isPlatinumAward          Boolean @default(false)
  isSustainabilityAward    Boolean @default(false)
  isInnovatexAward         Boolean @default(false)
  isProjectMarked          Boolean @default(false)

  @@unique([judgeId, projectId])
}

model Session {
  id        String   @id @default(uuid()) @map("_id")
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
